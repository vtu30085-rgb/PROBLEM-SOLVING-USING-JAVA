class Solution {

    public int strStr(String haystack, String needle) {

        if (needle.length() == 0) {
            return 0;
        }

        // Build LPS array for needle
        int[] lps = new int[needle.length()];

        int len = 0;
        int i = 1;

        while (i < needle.length()) {

            if (needle.charAt(i) == needle.charAt(len)) {
                lps[i] = len + 1;
                len++;
                i++;
            } else if (len > 0) {
                len = lps[len - 1];
            } else {
                lps[i] = 0;
                i++;
            }
        }

        // KMP search
        i = 0;
        int j = 0;

        while (i < haystack.length()) {

            if (haystack.charAt(i) == needle.charAt(j)) {
                i++;
                j++;

                // Complete match
                if (j == needle.length()) {
                    return i - j;
                }

            } else if (j > 0) {
                j = lps[j - 1];

            } else {
                i++;
            }
        }

        return -1;
    }
}
:::

### Example

```text
haystack = "sadbutsad"
needle   = "sad"
