import java.io.*;
import java.util.*;

public class Solution {

    static int[] manacherOdd(char[] s) {
        int n = s.length;
        int[] d = new int[n];

        int l = 0, r = -1;

        for (int i = 0; i < n; i++) {
            int k = (i > r) ? 1 : Math.min(d[l + r - i], r - i + 1);

            while (i - k >= 0 && i + k < n && s[i - k] == s[i + k]) {
                k++;
            }

            d[i] = k;

            if (i + k - 1 > r) {
                l = i - k + 1;
                r = i + k - 1;
            }
        }

        return d;
    }

    static int[] manacherEven(char[] s) {
        int n = s.length;
        int[] d = new int[n];

        int l = 0, r = -1;

        for (int i = 0; i < n; i++) {
            int k = (i > r) ? 0 : Math.min(d[l + r - i + 1], r - i + 1);

            while (i - k - 1 >= 0 && i + k < n &&
                   s[i - k - 1] == s[i + k]) {
                k++;
            }

            d[i] = k;

            if (i + k - 1 > r) {
                l = i - k;
                r = i + k - 1;
            }
        }

        return d;
    }

    /*
     * Returns longest palindrome for every rotation.
     */
    static int[] circularPalindromes(String str) {
        int n = str.length();

        if (n == 1) {
            return new int[]{1};
        }

        char[] s = new char[2 * n];
        for (int i = 0; i < 2 * n; i++) {
            s[i] = str.charAt(i % n);
        }

        int m = s.length;

        int[] odd = manacherOdd(s);
        int[] even = manacherEven(s);

        /*
         * best[i] = longest palindrome found directly for
         * rotation i.
         */
        int[] best = new int[n];

        /*
         * Process odd palindromes.
         *
         * A palindrome centered at c with radius odd[c]
         * has maximum length:
         *
         *     2 * odd[c] - 1
         *
         * We only care about palindromes whose length <= n,
         * because a rotation contains only n characters.
         *
         * For a palindrome to fit inside a rotation, its
         * starting position determines a range of rotations.
         */
        for (int c = 0; c < m; c++) {
            int radius = odd[c];

            int maxLen = Math.min(2 * radius - 1, n);

            /*
             * For each possible length, the corresponding
             * rotation interval can be represented using
             * difference arrays.
             *
             * We process the largest useful palindrome.
             */
            int left = c - maxLen / 2;
            int right = c + maxLen / 2;

            addInterval(best, n, left, right, maxLen);
        }

        /*
         * Process even palindromes.
         */
        for (int c = 0; c < m; c++) {
            int radius = even[c];

            int maxLen = Math.min(2 * radius, n);

            if (maxLen == 0) {
                continue;
            }

            int left = c - maxLen;
            int right = c + maxLen - 1;

            addInterval(best, n, left, right, maxLen);
        }

        /*
         * The above direct interval representation is not
         * sufficient by itself for every possible circular
         * placement, so explicitly propagate the answers.
         *
         * If a rotation has a palindrome of length L, shifting
         * the rotation by one position can reduce the maximum
         * possible palindrome by at most 2.
         */
        for (int i = 0; i < n; i++) {
            int next = (i + 1) % n;
            int prev = (i - 1 + n) % n;

            best[next] = Math.max(best[next], best[i] - 2);
            best[prev] = Math.max(best[prev], best[i] - 2);
        }

        /*
         * Repeat propagation enough times to cover the circle.
         */
        for (int pass = 0; pass < 2; pass++) {
            for (int i = 0; i < n; i++) {
                int next = (i + 1) % n;
                int prev = (i - 1 + n) % n;

                best[next] = Math.max(best[next], best[i] - 2);
                best[prev] = Math.max(best[prev], best[i] - 2);
            }
        }

        /*
         * Every rotation has at least a single-character
         * palindrome.
         */
        for (int i = 0; i < n; i++) {
            best[i] = Math.max(best[i], 1);
            best[i] = Math.min(best[i], n);
        }

        return best;
    }

    /*
     * Update rotations corresponding to a palindrome interval.
     *
     * Because rotations are circular, normalize the interval.
     */
    static void addInterval(int[] best, int n,
                            int left, int right, int value) {

        if (right - left + 1 >= n) {
            for (int i = 0; i < n; i++) {
                best[i] = Math.max(best[i], value);
            }
            return;
        }

        int start = ((left % n) + n) % n;
        int end = ((right % n) + n) % n;

        if (start <= end) {
            for (int i = start; i <= end; i++) {
                best[i] = Math.max(best[i], value);
            }
        } else {
            for (int i = start; i < n; i++) {
                best[i] = Math.max(best[i], value);
            }

            for (int i = 0; i <= end; i++) {
                best[i] = Math.max(best[i], value);
            }
        }
    }

    public static void main(String[] args) throws Exception {
        BufferedReader br =
                new BufferedReader(new InputStreamReader(System.in));

        String s = br.readLine().trim();

        int[] ans = circularPalindromes(s);

        StringBuilder out = new StringBuilder();

        for (int x : ans) {
            out.append(x).append('\n');
        }

        System.out.print(out);
    }
}
